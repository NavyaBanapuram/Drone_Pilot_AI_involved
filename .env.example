# ==========================================================
# DRONE PILOT — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local and fill in your project credentials.
# Never commit .env or .env.local to version control.
# ==========================================================

# Firebase Authentication & Firestore Configuration (Web Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional External Simulation Daemon Bridges (PX4 SITL / Gazebo ROS2)
# NEXT_PUBLIC_PX4_MAVLINK_WS_URL=ws://localhost:9090/mavlink
# NEXT_PUBLIC_GAZEBO_ROSBRIDGE_URL=ws://localhost:9090
